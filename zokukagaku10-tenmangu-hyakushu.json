 "poems": [
  {
   "seq": "1",
   "text": "めふ見えぞふる春雨おぬれおけりおつる雫比もりの下みち",
   "kana": "",
   "speaker": "",
   "page": 277,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "白雲れたゞよふ空にゆく雁廾きゆるかなさや越路なるらむ",
   "kana": "",
   "speaker": "",
   "page": 277,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "さゞなみや志賀の辛崎うち霞みほの〓〓あくる鏡やまかな",
   "kana": "",
   "speaker": "",
   "page": 277,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "かもかなる朧月夜のかげばかり春と玄らるゝ山かどのいほ",
   "kana": "",
   "speaker": "",
   "page": 277,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "窓ちかくうゑさる梅の花さきてよるも枕おかをりけるかな",
   "kana": "",
   "speaker": "",
   "page": 277,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "都びと若菜つまむと打むれて遊ぶさグ野のところせきまで",
   "kana": "",
   "speaker": "",
   "page": 277,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "ふしなれて鶯なけびくれ竹のかはらぬいろも春めきおけり",
   "kana": "",
   "speaker": "",
   "page": 277,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "はる霞うみの果までたちこめてのどかによする浪の音かな",
   "kana": "",
   "speaker": "",
   "page": 277,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "くみあげて結びしけさの若水ハ春と玄らぬやまだ氷りけり",
   "kana": "",
   "speaker": "",
   "page": 277,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "天の原長閑ふあくる今朝よりや風も春ぞと〓げわたるらむ",
   "kana": "",
   "speaker": "",
   "page": 277,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "うゑたるいすくなかりつる小山田の植ぬが稀お成おける哉",
   "kana": "",
   "speaker": "",
   "page": 277,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "打わたすほどもなけれど足曳の山も越えつゝ海もわたりぬ",
   "kana": "",
   "speaker": "",
   "page": 277,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "くはせがた近く鄰りて見えしかど漕よりぬれバ遙けかりけり",
   "kana": "",
   "speaker": "",
   "page": 277,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "玄ら雲の影さへうつる朝なぎお海こぎわたる卅の比どけさ",
   "kana": "",
   "speaker": "",
   "page": 277,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "雨や降る嵐や吹くとおもふまで落ち來る水の音比すゞしさ",
   "kana": "",
   "speaker": "",
   "page": 277,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "わく水の底より秋やたちぬらむ早くすヾしき浪のおとかな",
   "kana": "",
   "speaker": "",
   "page": 278,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "うち渡を遠山ざとの垣根までさやかに見よとさけるうの花",
   "kana": "",
   "speaker": "",
   "page": 278,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "奧山の谷ふところにさく花い春のくせしも玄らずや有らむ",
   "kana": "",
   "speaker": "",
   "page": 278,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "みどり濃き花の盛とみゆるかな夏あうつれる志賀の山さと",
   "kana": "",
   "speaker": "",
   "page": 278,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "殘りける春の日數をかぞふれどまちし時さへ戀しかりけり",
   "kana": "",
   "speaker": "",
   "page": 278,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "おちさぎつ瀧廾白糸むらさきにそめかへたりな藤波のはな",
   "kana": "",
   "speaker": "",
   "page": 278,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "千年ふるこりの綠も色かへていはほの上に咲くつゝじかな",
   "kana": "",
   "speaker": "",
   "page": 278,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "けふよりいかゝげておかむ篠簾ひまなく通ふつばくらグ爲",
   "kana": "",
   "speaker": "",
   "page": 278,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "奥山比このまの櫻さきおけりまつも檜原もはるや知るらむ",
   "kana": "",
   "speaker": "",
   "page": 278,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "あはれわが待つ人まちて櫻花ちらバをしとも思はざらまし",
   "kana": "",
   "speaker": "",
   "page": 278,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "こよろぎの磯やまざくら心なく波のうへおもちりにける哉",
   "kana": "",
   "speaker": "",
   "page": 278,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "もる人もなき逢坂のせきなれど花おいとまる我こゝろかな",
   "kana": "",
   "speaker": "",
   "page": 278,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "春なれど霞みもやらぬ大比叡比たかねの櫻いつり咲くらむ",
   "kana": "",
   "speaker": "",
   "page": 278,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "舟とむるむかひの岸の靑柳のかげさへ深くなりおけるかな",
   "kana": "",
   "speaker": "",
   "page": 278,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "はらへする此川の瀨ふ大ぬさの漂ふ見れバいかゞとぞ思ふ",
   "kana": "",
   "speaker": "",
   "page": 278,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "不忍のいけ比かぎりを花ふしてみもる蓮のうつくしきかな",
   "kana": "",
   "speaker": "",
   "page": 278,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "あやせ川波の上てる月かげお夏もすゞしといはぬ夜いなし",
   "kana": "",
   "speaker": "",
   "page": 278,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "夏艸の玄げみにおける夕露をかぜおちらせて見るぞ凉しき",
   "kana": "",
   "speaker": "",
   "page": 278,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "曉に夜いなりぬらむ長良川うぶねのかゞりかげゑらみゆく",
   "kana": "",
   "speaker": "",
   "page": 278,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "照射さすとかみぶ原ふよる鹿いなく秋よりもあはれんけり",
   "kana": "",
   "speaker": "",
   "page": 278,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "も之ほやく烟いたえて五月雨比雲のなみさつ須磨比浦かな",
   "kana": "",
   "speaker": "",
   "page": 278,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "うゑていにし門田のさ苗打靡きみどりに見ゆる風の凉しさ",
   "kana": "",
   "speaker": "",
   "page": 278,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "梅雨のふる江の菖蒲おりたちてひけバ袖さへ香ふ匂ひつゝ",
   "kana": "",
   "speaker": "",
   "page": 278,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "郭公かげさへとめずなりおけりわが乘る駒も早しと思ふふ",
   "kana": "",
   "speaker": "",
   "page": 278,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "時鳥いちのさわぎやいとふらむ早くもよそに過ぎおける哉",
   "kana": "",
   "speaker": "",
   "page": 278,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "まつ人ハあまさありとも時鳥はつ聲のみいこゝに來てなけ",
   "kana": "",
   "speaker": "",
   "page": 278,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "荒はてし垣ねをおのぶ物にしてさける朝顏あはれならずや",
   "kana": "",
   "speaker": "",
   "page": 279,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "夜もすがらともと我見し月なれがありたる後も哀とぞ思ふ",
   "kana": "",
   "speaker": "",
   "page": 279,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "誰の知る閨比妻戶をあけおきて今宵い月とわがふたりねし",
   "kana": "",
   "speaker": "",
   "page": 279,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "水底のかげをまことゝ思ふまですみこそ渡れ秋の夜比つき",
   "kana": "",
   "speaker": "",
   "page": 279,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "雲きりい松ふく風にはらはせてさやかに照すやまのはの月",
   "kana": "",
   "speaker": "",
   "page": 279,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "ひさかさの空ゆく月をわぶ宿のまつの梢ふやどしてぞ見る",
   "kana": "",
   "speaker": "",
   "page": 279,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "あふ坂の山ふみならし深き夜にひかるゝ駒ハかひのくろ駒",
   "kana": "",
   "speaker": "",
   "page": 279,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "播磨潟いほの湊およらぞしてこぎくる舟い雁おぞありける",
   "kana": "",
   "speaker": "",
   "page": 279,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "さをしかいなきて獨や通ふらむ秋かぜさむき岡ごえのみち",
   "kana": "",
   "speaker": "",
   "page": 279,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "旅なれパわれも故〓こほろぎのなきあかしたる秋のよは哉",
   "kana": "",
   "speaker": "",
   "page": 279,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "朝な〓〓おくとも見えぬ苔の上の露おも裾をぬらしつる哉",
   "kana": "",
   "speaker": "",
   "page": 279,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "藤袴露ふみわけてきて見れバ雨おもいろいうつらざりけり",
   "kana": "",
   "speaker": "",
   "page": 279,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "いかばかり秋を樂しと思ふらむとなりい萩の花さかりなり",
   "kana": "",
   "speaker": "",
   "page": 279,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "ふる里のにはの荻原かぜ吹けバわが袖よりも露ぞみざるゝ",
   "kana": "",
   "speaker": "",
   "page": 279,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "あま北川たえぬ契いいちじろく流れて後もいく世へぬらむ",
   "kana": "",
   "speaker": "",
   "page": 279,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "よもすがらおろも嵐比風さえて初雪ふれりかつちき北みね",
   "kana": "",
   "speaker": "",
   "page": 279,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "くれ〓さる片山かげの小松ばらいへ路忘れて狩る人やたれ",
   "kana": "",
   "speaker": "",
   "page": 279,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "谷川のみづの底までこほる夜い嵐のみこそさえわさりけれ",
   "kana": "",
   "speaker": "",
   "page": 279,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "ちどりなく聲もかなしき曉おいさくな吹きそ賀茂比川かぜ",
   "kana": "",
   "speaker": "",
   "page": 279,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "雪のおと積れるけさ北霜見れがそヾろ寒けき庭のおもかな",
   "kana": "",
   "speaker": "",
   "page": 279,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "千年へむすみかやいづこ冬ながら菊比花さくたく山比みち",
   "kana": "",
   "speaker": "",
   "page": 279,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "さそふべき一葉もなきを夕まぐれ何ふきつのる木枯のかぜ",
   "kana": "",
   "speaker": "",
   "page": 279,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "神無月たちぬときけど今日よりと玄るきい過る時雨んけり",
   "kana": "",
   "speaker": "",
   "page": 279,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "今やがて秋いくるゝク加はりし長月さへもとヾまらずして",
   "kana": "",
   "speaker": "",
   "page": 279,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "吹渡る風のまに〓〓ちる見れバ黄葉い染しかひなかりけり",
   "kana": "",
   "speaker": "",
   "page": 279,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "秋あぜ比ふく時ばかりきこにつゝ衣打和のさと比はるろき",
   "kana": "",
   "speaker": "",
   "page": 279,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "ゆふ烟きりの中おもなびきつゝくれわさりぬる小山田の里",
   "kana": "",
   "speaker": "",
   "page": 279,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "打よせてかへらぬ浪と見ゆるかな雪にをれふす芦のむら立",
   "kana": "",
   "speaker": "",
   "page": 280,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "人もこぬ片山ざとの冬ごもりあはれと思へねや北うづみ火",
   "kana": "",
   "speaker": "",
   "page": 280,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "たち比がる煙も雲となりおけり遙お見ゆる小野のもみがま",
   "kana": "",
   "speaker": "",
   "page": 280,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "春ちかくなりぬと風や亥らすらむ雪の中より梅グ香ぞする",
   "kana": "",
   "speaker": "",
   "page": 280,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "なすわざい家々ごとにかはれどもふなじ心に春をこそまて",
   "kana": "",
   "speaker": "",
   "page": 280,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "思ふともこふともいまざいはずしてつくす心を哀といゑれ",
   "kana": "",
   "speaker": "",
   "page": 280,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "75",
   "text": "かくばかりくるしきものを恐山など我戀のなかにおきけむ",
   "kana": "",
   "speaker": "",
   "page": 280,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "76",
   "text": "時鳥まちあかさむといひしもやひとに去らるゝ始なりタむ",
   "kana": "",
   "speaker": "",
   "page": 280,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "77",
   "text": "人づてにきゝても空になりぬるい戀にうきさる心なまけり",
   "kana": "",
   "speaker": "",
   "page": 280,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "78",
   "text": "鶯のはなに來てなく聲よりもきみお聲こそきかまほしりれ",
   "kana": "",
   "speaker": "",
   "page": 280,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "79",
   "text": "折にふれ時おつけつゝ見るのみを思出おして世をや盡さむ",
   "kana": "",
   "speaker": "",
   "page": 280,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "80",
   "text": "今いわが文だお手おいふれじとや憎くも人北かへしつる哉",
   "kana": "",
   "speaker": "",
   "page": 280,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "81",
   "text": "野おもあらじ山あもあらじ我あのみ立隱れたる妹がすみかい",
   "kana": "",
   "speaker": "",
   "page": 280,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "82",
   "text": "松が枝の千世をかけさる言のはい昔のいろに變らざりけり",
   "kana": "",
   "speaker": "",
   "page": 280,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "83",
   "text": "かならずといひし今宵も徒おきてい歸るぞかなしあきらる",
   "kana": "",
   "speaker": "",
   "page": 280,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "84",
   "text": "曉のとりもきかずてかへせしいいめり現クまさもねて見む",
   "kana": "",
   "speaker": "",
   "page": 280,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "85",
   "text": "あけぬとて別れしことの悲しきいけさとなりての心えけり",
   "kana": "",
   "speaker": "",
   "page": 280,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "86",
   "text": "戀の山日ごとに深くわけいりてまどふ苦しさ玄る人もなし",
   "kana": "",
   "speaker": "",
   "page": 280,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "87",
   "text": "何ふかく賤しき身とい生れけむこふと色おもいでグさき迄",
   "kana": "",
   "speaker": "",
   "page": 280,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "88",
   "text": "今い我家をも名をも忘れけむ風のたよりもせぞなりにけり",
   "kana": "",
   "speaker": "",
   "page": 280,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "89",
   "text": "あけさてバ風やなもらむ奧山の谷比とぼそい雲ぞとぢさる",
   "kana": "",
   "speaker": "",
   "page": 280,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "90",
   "text": "山風H松にうちふくこゑさへも夕べきびしき我すまひうな",
   "kana": "",
   "speaker": "",
   "page": 280,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "91",
   "text": "ふる雨にぬらして見れバ吳竹の綠あまさるいろなかりけり",
   "kana": "",
   "speaker": "",
   "page": 280,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "92",
   "text": "糺川みづいかばうりきよけれバ底もさやかに見え渡るらむ",
   "kana": "",
   "speaker": "",
   "page": 280,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "93",
   "text": "風ふけバ浪うちつけお聞ゆなり沖比たかものあし鶴のこゑ",
   "kana": "",
   "speaker": "",
   "page": 280,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "94",
   "text": "朝夕にけぶりたゝずバ奧山のもみかい人お玄られざらまし",
   "kana": "",
   "speaker": "",
   "page": 281,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "95",
   "text": "かりあげし門田ふあさる家鳩い引板の音ふもおれてける哉",
   "kana": "",
   "speaker": "",
   "page": 281,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "96",
   "text": "難波江の堀江おたてるむら蘆いみをつくしとも成ふりる哉",
   "kana": "",
   "speaker": "",
   "page": 281,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "97",
   "text": "いうだくむにふの柚川水を淺み雨まち顏ふ見ゆるころかな",
   "kana": "",
   "speaker": "",
   "page": 281,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "98",
   "text": "奥山の木こりグ道のつヾらを〓蕨をりつゝこの日くらしつ",
   "kana": "",
   "speaker": "",
   "page": 281,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "99",
   "text": "ふる里い夢の內ふも見えざりき夜たゞかぢうつなみの騷お",
   "kana": "",
   "speaker": "",
   "page": 281,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "100",
   "text": "風ふけバ浪ふもきえて見ゆるんいらごら島の蜑のいさり火",
   "kana": "",
   "speaker": "",
   "page": 281,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "101",
   "text": "老ぬとてなげく心いなきものを夢も見はてぞいづ成おけむ",
   "kana": "",
   "speaker": "",
   "page": 281,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "102",
   "text": "世間いおもひの外のものなれや獨ありてもやをけくもなし",
   "kana": "",
   "speaker": "",
   "page": 281,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "103",
   "text": "神垣のさかき葉とりて祝ふにもまづ君グ代といはれける哉",
   "kana": "",
   "speaker": "",
   "page": 281,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  }
